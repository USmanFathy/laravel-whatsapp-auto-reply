APP_NAME="OpenWA Inbox"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Keep "database" and run the queue worker. Do NOT use "sync": it sends the reply inside the webhook request.
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=


# ---- OpenWA connection (no real values are shipped) ----
OPENWA_BASE_URL=http://127.0.0.1:2785
# API key printed by OpenWA on first start (see WINDOWS-SETUP.md)
OPENWA_API_KEY=
# The full session UUID (36 characters) from POST /api/sessions or the OpenWA dashboard
OPENWA_SESSION_ID=
# A random string of at least 16 characters, used to sign/verify webhooks. NOT the API key.
OPENWA_WEBHOOK_SECRET=
# Where OpenWA POSTs events (used by `php artisan openwa:register-webhook`)
OPENWA_WEBHOOK_URL=http://127.0.0.1:8000/api/openwa/webhook

OPENWA_TIMEOUT=15
OPENWA_HTTP_RETRIES=2
OPENWA_HTTP_RETRY_DELAY_MS=300

# ---- Login for http://127.0.0.1:8000/auto-reply (HTTP Basic). The page stays disabled until a password is set ----
AUTO_REPLY_ADMIN_USER=admin
AUTO_REPLY_ADMIN_PASSWORD=

# Safety valve against two auto-responders looping: max replies to the SAME number per rolling minute (0 = off)
AUTO_REPLY_MAX_PER_SENDER_PER_MINUTE=6
# Incoming messages older than this are not answered (reason is logged)
AUTO_REPLY_MAX_MESSAGE_AGE_SECONDS=3600
# Reply inside WhatsApp groups too? (normally no)
AUTO_REPLY_IN_GROUPS=false
